async function openLearning(level,focusLessonId=null){currentLevel=level;returnToLevel=true;hideAll();$('paidLearningPage').classList.remove('hidden');$('learningPageTitle').textContent='المستوى '+level;$('learningOrb').textContent=level;$('learningPageDescription').textContent='دروسك وفيديوهاتك وتدريباتك في مكان واحد.';$('learningLessonsList').innerHTML='<div class="empty-state">جارٍ تحميل الدروس...</div>';$('learningLevelExam').replaceChildren();hideNote('learningPageNotice');window.scrollTo({top:0,behavior:'smooth'});try{const admin=await isAdmin();if(!admin&&!(await hasActiveSubscription(level))){note('learningPageNotice','لا يوجد اشتراك مفعّل لهذا المستوى.','error');$('learningLessonsList').replaceChildren();return}if(LEVELS[level].prev&&!admin){const {data:p,error:pe}=await supabaseClient.from('student_level_progress').select('exam_score,exam_passed').eq('user_id',currentUser.id).eq('level_code',LEVELS[level].prev).maybeSingle();if(pe)throw pe;if(!p||p.exam_passed!==true||Number(p.exam_score)<75){note('learningPageNotice','يجب اجتياز المستوى السابق بنسبة 75% على الأقل.','error');$('learningLessonsList').replaceChildren();return}}const {data:lessonsData,error}=await supabaseClient.from('level_lessons').select('id,title,description,video_url,content,sort_order').eq('level_code',level).eq('is_published',true).order('sort_order',{ascending:true});if(error)throw error;const list=$('learningLessonsList');list.replaceChildren();if(!lessonsData||!lessonsData.length)list.innerHTML='<div class="empty-state">لا توجد دروس منشورة حتى الآن.</div>';(lessonsData||[]).forEach(l=>{const card=document.createElement('article');card.className='paid-lesson';card.id='paidlesson-'+l.id;const h=document.createElement('h3');h.textContent=l.title;card.append(h);if(l.description){const p=document.createElement('p');p.textContent=l.description;card.append(p)}if(l.content){const p=document.createElement('p');p.textContent=l.content;card.append(p)}if(l.video_url){const a=document.createElement('a');a.href=l.video_url;a.target='_blank';a.rel='noopener noreferrer';a.textContent='مشاهدة فيديو الدرس ↗';card.append(a)}const watch=document.createElement('button');watch.className='btn primary';watch.textContent='شاهد الدرس';watch.onclick=()=>{const player=$('learningPlayer');$('learningPlayerCaption').textContent=l.title;player.querySelector('iframe')?.remove();const prior=player.querySelector('.player-placeholder');if(prior)prior.remove();if(l.video_url){let url=l.video_url;const yt=url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/);if(yt)url='https://www.youtube-nocookie.com/embed/'+yt[1];const frame=document.createElement('iframe');frame.src=url;frame.title=l.title;frame.allow='accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';frame.allowFullscreen=true;player.insertBefore(frame,player.querySelector('.player-caption'))}else{const ph=document.createElement('div');ph.className='player-placeholder';ph.innerHTML='<div><strong></strong><span>لا يوجد رابط فيديو لهذا الدرس حتى الآن</span></div>';ph.querySelector('strong').textContent=l.title;player.insertBefore(ph,player.querySelector('.player-caption'))}player.scrollIntoView({behavior:'smooth',block:'start'})};card.append(watch);const b=document.createElement('button');b.className='btn secondary';b.textContent='علّم الدرس كمكتمل';b.onclick=()=>completePaidLesson(l.id,level);card.append(b);list.append(card)});$('learningProgressText').textContent=(lessonsData||[]).length+' درس في المستوى';$('learningProgressBar').style.width='0%';await loadLearningExam(level);if(focusLessonId){const target=$('paidlesson-'+focusLessonId);if(target)target.scrollIntoView({behavior:'smooth',block:'center'})}}catch(e){console.error(e);note('learningPageNotice','تعذر تحميل الدروس أو الاختبار: '+(e.message||e),'error');$('learningLessonsList').innerHTML='<div class="empty-state">حدث خطأ في تحميل محتوى المستوى.</div>'}}
