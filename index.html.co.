-state">اجتز المستوى السابق أولًا.</div>';return}}$('paidLevelSubscription').innerHTML='<div class="price-box"><span class="tag">تم التفعيل</span><h3>اشتراك '+level+'</h3><p>المحتوى متاح لحسابك.</p><button class="btn primary full" id="goLearning">ابدأ التعلّم</button></div>';$('goLearning').onclick=()=>openLearning(level);const {data,error}=await supabaseClient.from('level_lessons').select('id,title,description,video_url,content,sort_order').eq('level_code',level).eq('is_published',true).order('sort_order',{ascending:true});if(error)throw error;const box=$('paidLevelContent');box.replaceChildren();if(!data||!data.length){box.innerHTML='<div class="empty-state">لا توجد دروس منشورة لهذا المستوى حتى الآن.</div>';return}const list=document.createElement('div');list.className='lesson-list';data.forEach(l=>{const c=document.createElement('article');c.className='paid-lesson';const h=document.createElement('h3');h.textContent=l.title;c.append(h);if(l.description){const p=document.createElement('p');p.textContent=l.description;c.append(p)}const b=document.createElement('button');b.className='btn primary';b.textContent='فتح الدرس';b.onclick=()=>openLearning(level,l.id);c.append(b);list.append(c)});box.append(list)}catch(e){console.error(e);$('paidLevelDescription').textContent='تعذر تحميل المستوى.';note('paidLevelNotice','حدث خطأ أثناء تحميل المستوى: '+(e.message||e),'error')}}
