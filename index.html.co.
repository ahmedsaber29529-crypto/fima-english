function renderSentences(){const box=$('sentenceList');if(!box)return;const q=($('sentenceSearch').value||'').trim().toLowerCase();box.replaceChildren();sentences.forEach((s,i)=>{if(q&&!s[0].toLowerCase().includes(q)&&!s[1].includes(q))return;const card=document.createElement('article');card.className='sentence-item';const en=document.createElement('div');en.className='sentence-en';en.textContent=(i+1)+'. '+s[0];const ar=document.createElement('div');ar.className='sentence-ar';ar.textContent=s[1];const b=document.createElement('button');b.className='btn ghost';b.textContent='استمع';b.onclick=()=>speakEnglish(s[0]);card.append(en,ar,b);box.append(card)})}
