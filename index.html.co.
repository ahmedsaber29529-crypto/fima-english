async function loadStudents(){const body=$('studentsBody');body.innerHTML='<tr><td colspan="3">جارٍ التحميل...</td></tr>';try{if(!(await isAdmin()))throw new Error('لا توجد صلاحية مدير');let {data,error}=await supabaseClient.from('profiles').select('*').order('created_at',{ascending:false}).limit(200);if(error)throw error;const term=($('studentSearch').value||'').trim().toLowerCase();data=(data||[]).filter(p=>!term||String(p.full_name||p.name||'').toLowerCase().includes(term)||String(p.email||'').toLowerCase().includes(term));body.replaceChildren();if(!data.length){body.innerHTML='<tr><td colspan="3">لا توجد نتائج.</td></tr>';return}data.forEach(p=>{const tr=document.createElement('tr');[p.full_name||p.name||'—',p.email||'—',p.created_at?new Date(p.created_at).toLocaleDateString('ar-EG'):'—'].forEach(v=>{const td=document.createElement('td');td.textContent=v;tr.append(td)});body.append(tr)})}catch(e){body.innerHTML='<tr><td colspan="3">تعذر تحميل الطلاب: '+e.message+'</td></tr>'}}
async function loadSubscriptionRequests(){const list=$('subscriptionRequestsList');list.innerHTML='جارٍ تحميل الطلبات...';hideNote('subscriptionRequestsNotice');try{if(!(await isAdmin()))throw new Error('لا توجد صلاحية مدير');const {data,error}=await supabaseClient.from('subscription_requests').select('id,user_id,plan,amount,payment_method,transaction_reference,status,created_at').order('created_at',{ascending:false});if(error)throw error;list.replaceChildren();if(!data?.length){list.innerHTML='<div class="empty-state">لا توجد طلبات اشتراك حتى الآن.</div>';return}data.forEach(r=>{const c=document.createElement('article');c.className='card';c.style.marginBottom='12px';const p=document.createElement('p');p.textContent='المستوى: '+r.plan+' | المبلغ: '+r.amount+' جنيه | طريقة الدفع: '+r.payment_method+' | مرجع العملية: '+r.transaction_reference+' | الحالة: '+r.status+' | التاريخ: '+new Date(r.created_at).toLocaleString('ar-EG');c.append(p);if(r.status==='pending'){[['approved','قبول الاشتراك'],['rejected','رفض الطلب']].forEach(([v,label])=>{const b=document.createElement('button');b.className='btn '+(v==='approved'?'primary':'secondary');b.style.margin='4px';b.textContent=label;b.onclick=()=>reviewSubscriptionRequest(r.id,v);c.append(b)})}list.append(c)})}catch(e){note('subscriptionRequestsNotice','تعذر تحميل الطلبات: '+e.message,'error');list.replaceChildren()}}
async function reviewSubscriptionRequest(id,decision){if(!confirm(decision==='approved'?'هل تحققت من وصول المبلغ الحقيقي وتريد تفعيل الاشتراك؟':'هل تريد رفض طلب الاشتراك؟'))return;try{if(!(await isAdmin()))throw new Error('ليس لديك صلاحية');const {data,error}=await supabaseClient.rpc('fima_review_subscription_request',{p_request_id:id,p_decision:decision});if(error)throw error;toast(data||'تمت مراجعة الطلب.','success');await loadSubscriptionRequests()}catch(e){toast('لم تتم مراجعة الطلب: '+e.message,'error')}}
async function adminAddLesson(){const n=$('lessonAdminNotice');hideNote(n);try{if(!(await isAdmin()))throw new Error('ليس لديك صلاحية مدير');const title=$('lessonTitleInput').value.trim();if(!title)throw new Error('اكتب عنوان الدرس.');const {data,error}=await supabaseClient.rpc('fima_manage_lesson',{p_action:'add',p_level_code:$('lessonLevel').value,p_title:title,p_description:$('lessonDescriptionInput').value.trim()||null,p_video_url:$('lessonVideoInput').value.trim()||null,p_content:$('lessonContentInput').value.trim()||null,p_sort_order:Number($('lessonOrderInput').value)||1,p_is_published:$('lessonPublishInput').checked});if(error)throw error;if(!data||data.success!==true)throw new Error(data?.message||'لم يتم حفظ الدرس');note(n,'تمت إضافة الدرس.','success');['lessonTitleInput','lessonDescriptionInput','lessonVideoInput','lessonContentInput'].forEach(id=>$(id).value='');$('lessonPublishInput').checked=false}catch(e){note(n,'تعذر حفظ الدرس: '+e.message,'error')}}
async function adminAddExamQuestion(){const n=$('examAdminNotice');hideNote(n);try{if(!(await isAdmin()))throw new Error('ليس لديك صلاحية مدير');const question=$('examQuestionInput').value.trim(),a=$('examOptionA').value.trim(),b=$('examOptionB').value.trim(),c=$('examOptionC').value.trim(),d=$('examOptionD').value.trim();if(!question||!a||!b||!c||!d)throw new Error('اكتب السؤال والاختيارات الأربعة.');const {data,error}=await supabaseClient.rpc('fima_manage_exam_question',{p_action:'add',p_level_code:$('examLevel').value,p_question_text:question,p_option_a:a,p_option_b:b,p_option_c:c,p_option_d:d,p_correct_option:$('examCorrectOption').value,p_sort_order:Number($('examOrderInput').value)||1});if(error)throw error;if(!data||data.success!==true)throw new Error(data?.message||'لم يتم حفظ السؤال');note(n,'تمت إضافة سؤال الامتحان.','success');['examQuestionInput','examOptionA','examOptionB','examOptionC','examOptionD'].forEach(id=>$(id).value='')}catch(e){note(n,'تعذر حفظ السؤال: '+e.message,'error')}}
async function forgotPassword(){const email=$('email').value.trim();if(!email){note('modalNotice','اكتب بريدك الإلكتروني أولًا.','error');return}try{const {error}=await supabaseClient.auth.resetPasswordForEmail(email,{redirectTo:location.origin+location.pathname});if(error)throw error;note('modalNotice','لو البريد مسجل، هيوصلك رابط استعادة كلمة المرور.','success')}catch(e){note('modalNotice',translateError(e.message),'error')}}
supabaseClient.auth.onAuthStateChange((event,session)=>{currentUser=session?.user||null;if(currentUser){setTimeout(()=>afterLogin(),0)}else{$('loginBtn').classList.remove('hidden');$('accountBtn').classList.add('hidden');$('adminBtn').classList.add('hidden');$('logoutBtn').classList.add('hidden')}});
(async()=>{ $('year').textContent=new Date().getFullYear();renderLessons();renderSentences();try{const {data}=await supabaseClient.auth.getSession();if(data.session){currentUser=data.session.user;await afterLogin()}}catch(e){note('globalNotice','تعذر الاتصال بخدمة الحسابات. راجع إعدادات Supabase والمفتاح العام.','error')}})();
</script>
