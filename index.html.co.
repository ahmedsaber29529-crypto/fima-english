async function loadLearningExam(level){const box=$('learningLevelExam');box.innerHTML='<p class="small">جارٍ تحميل الاختبار...</p>';try{const {data:questions,error}=await supabaseClient.rpc('fima_get_level_exam',{p_level_code:level});if(error)throw error;box.replaceChildren();if(!Array.isArray(questions)||!questions.length){box.innerHTML='<div class="empty-state">لا توجد أسئلة منشورة لهذا المستوى حتى الآن.</div>';return}const admin=await isAdmin();if(admin){const p=document.createElement('p');p.className='notice';p.textContent='وضع المدير: معاينة الأسئلة فقط.';box.append(p)}const form=document.createElement('form');questions.forEach((q,i)=>{const field=document.createElement('fieldset');field.className='exam-question';const legend=document.createElement('legend');legend.textContent=(i+1)+'. '+q.question_text;field.append(legend);[['A',q.option_a],['B',q.option_b],['C',q.option_c],['D',q.option_d]].forEach(([letter,txt])=>{const label=document.createElement('label');const input=document.createElement('input');input.type='radio';input.name=q.question_id;input.value=letter;input.required=true;label.append(input,document.createTextNode(' '+letter+') '+(txt||'')));field.append(label)});form.append(field)});if(!admin){const b=document.createElement('button');b.className='btn primary full';b.textContent='تسليم الاختبار';form.append(b);form.addEventListener('submit',async e=>{e.preventDefault();const answers=questions.map(q=>{const selected=form.querySelector('input[name="'+q.question_id+'"]:checked');return{question_id:q.question_id,answer:selected?selected.value:''}});if(answers.some(a=>!a.answer)){toast('جاوب عن كل الأسئلة أولًا.','error');return}b.disabled=true;try{const {data:result,error}=await supabaseClient.rpc('fima_submit_level_exam',{p_level_code:level,p_answers:answers});if(error)throw error;box.replaceChildren();const h=document.createElement('h3');h.textContent=result.passed?'مبروك! اجتزت المستوى.':'تحتاج إلى مراجعة الدروس والمحاولة مجددًا.';const p=document.c