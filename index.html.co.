async function updateAccount(){if(!currentUser)return;$('accountName').textContent=currentUser.user_metadata?.full_name||currentUser.user_metadata?.name||'حساب الطالب';$('accountEmail').textContent=currentUser.email||'';updateProgress();try{const {data,error}=await supabaseClient.from('subscriptions').select('plan,starts_at,expires_at,status').eq('user_id',currentUser.id).order('starts_at',{ascending:false});if(error)throw error;const active=(data||[]).find(s=>s.status==='active'&&(!s.expires_at||new Date(s.expires_at)>new Date()));const pending=await supabaseClient.from('subscription_requests').select('plan,status').eq('user_id',currentUser.id).eq('status','pending').limit(1);$('accountLevel').textContent=active?.plan||pending.data?.[0]?.plan||'—';$('accountSubscriptionStatus').textContent=active?'نشط':pending.data?.length?'قيد المراجعة':'غير مشترك';$('accountStartDate').textContent=active?.starts_at?new Date(active.starts_at).toLocaleDateString('ar-EG'):'—';$('accountEndDate').textContent=active?.expires_at?new Date(active.expires_at).toLocaleDateString('ar-EG'):'مفتوح حاليًا';$('accountSubscriptionMessage').textContent=active?'اشتراكك في '+active.plan+' مفعّل.':pending.data?.length?'طلب الاشتراك وصل للإدارة وينتظر المراجعة.':'ليس لديك اشتراك مفعّل حاليًا.'}catch(e){$('accountSubscriptionStatus').textContent='غير متاح';$('accountSubscriptionMessage').textContent='تعذر تحميل بيانات الاشتراك. '+e.message}}
