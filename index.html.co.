<header class="top"><div class="wrap nav">
<a class="brand" href="#" onclick="showHome();return false"><span class="logo">ف</span><span>فيما <small>FIMA ENGLISH</small></span></a>
<div class="navactions">
<button class="btn ghost" onclick="document.getElementById('lessons').scrollIntoView({behavior:'smooth'})">الدروس المجانية</button>
